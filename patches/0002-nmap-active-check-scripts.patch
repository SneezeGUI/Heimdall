+    # Default NSE set. `vulners.nse` alone is CPE-string matching and yields
+    # hundreds of non-applicable CVEs per host. The `*-vuln-*` scripts below
+    # are *active checks* that produce a real VULNERABLE / not-vulnerable
+    # verdict, which is what the exploit engine can actually act on.
+    DEFAULT_NSE_SCRIPTS = (
+        "vulners.nse",
+        "smb-vuln-ms17-010.nse",
+        "smb-vuln-cve-2009-3103.nse",
+        "smb-vuln-cve2009-3103.nse",
+        "smb-vuln-regsvc-dos.nse",
+        "ssl-heartbleed.nse",
+        "ssl-poodle.nse",
+        "ssl-ccs-injection.nse",
+        "ssl-dh-params.nse",
+        "http-vuln-cve2017-5638.nse",
+        "http-vuln-cve2014-0160.nse",
+    )
+
+    def _nse_script_spec(self) -> str:
+        """Return the comma-joined NSE script list (config-overridable)."""
+        raw = self.shared_data.config.get("nmap_vuln_scripts")
+        if isinstance(raw, str) and raw.strip():
+            return raw.strip()
+        if isinstance(raw, (list, tuple)) and raw:
+            return ",".join(str(x).strip() for x in raw if str(x).strip())
+        return ",".join(self.DEFAULT_NSE_SCRIPTS)
 
